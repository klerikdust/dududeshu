<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.25.0</Version>
    <Authors>xduduking</Authors>
    <AssemblyName>dududeshu</AssemblyName>
    <PackageProjectUrl>https://github.com/klerikdust/dududeshu</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Data\dudu.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <!-- Compiled from Data/ffxiv_jp_en_dataset.json; read by Services/FfxivGlossary.cs. -->
    <EmbeddedResource Include="..\Data\ffxiv_jp_glossary.json" LogicalName="dududeshu.ffxiv_jp_glossary.json">
      <Visible>false</Visible>
    </EmbeddedResource>
  </ItemGroup>
</Project>
